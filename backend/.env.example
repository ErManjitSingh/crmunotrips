PORT=5000
NODE_ENV=production

# Local MongoDB on the same VPS (default database name if unset in code)
MONGO_URI=mongodb://127.0.0.1:27017/testing_unotrips_crm

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=30d

# Comma-separated allowed frontend origins
CORS_ORIGINS=https://testing.unotrips.com,http://localhost:5173

SEED_PASSWORD=123456

# Optional — shared cache across PM2 workers (falls back to in-memory if unavailable)
REDIS_URL=redis://127.0.0.1:6379

# Web Push (multi-device notifications) — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Feature no-ops safely if unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@unotrips.com

# Enterprise email (Nodemailer) — sender: sales@unotrips.com
# Hostinger: use port 465 (implicit TLS; secure is auto-detected)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=sales@unotrips.com
SMTP_PASS=
SMTP_FROM_NAME=UNO Trips

# Email reply tracking (IMAP — defaults to SMTP credentials if unset)
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# IMAP_USER=sales@unotrips.com
# IMAP_PASS=
# EMAIL_INBOX_POLL_MS=300000

# Uno Hotels package catalog (quotation builder)
# On VPS use local uno-backend: http://127.0.0.1:8000
# Public URL: https://api.unohotelsandresorts.com
UNO_HOTELS_API_BASE_URL=https://api.unohotelsandresorts.com
# Use admin Package Control API (recommended). Set token OR email/password:
# UNO_HOTELS_ADMIN_TOKEN=
# UNO_HOTELS_ADMIN_EMAIL=
# UNO_HOTELS_ADMIN_PASSWORD=
# Ops API — staff rate overrides (/ops/v1/properties/.../rate-overrides). Only hotels with overrides change.
# UNO_HOTELS_OPS_USERNAME=
# UNO_HOTELS_OPS_PASSWORD=
# UNO_HOTELS_RATE_OVERRIDE_CHANNEL=staff

# Call recording transcription (UNO Sales Tracker app) via OpenRouter speech-to-text.
# Leave OPENROUTER_API_KEY empty to keep transcription off (recordings are still stored).
OPENROUTER_API_KEY=
TRANSCRIBE_MODEL=openai/gpt-4o-transcribe
# Private folder for call recordings (must NOT be under the public uploads/ folder).
CALL_RECORDINGS_DIR=
