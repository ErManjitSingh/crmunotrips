# Copy to VPS:
#   cp deploy/env/backend.env.production /var/www/testing-unotrips-crm/backend/.env
# Then edit JWT_SECRET before going live.

PORT=5000
NODE_ENV=production

MONGO_URI=mongodb://127.0.0.1:27017/testing_unotrips_crm

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=30d

CORS_ORIGINS=https://testing.unotrips.com,https://unotrips.com,https://www.unotrips.com

SEED_PASSWORD=123456

REDIS_URL=redis://127.0.0.1:6379

UNO_HOTELS_API_BASE_URL=http://127.0.0.1:8000

# Meta landing / chatbot → CRM ingest (set same key in meta/_shared/crm_lead_push.php)
META_LEAD_API_KEY=unotrips-meta-lead-2026-secure
# Optional: force public leads into a branch ObjectId
# PUBLIC_LEAD_BRANCH_ID=
